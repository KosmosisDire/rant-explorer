<rml>

	<head>
		<title>Rant Explorer</title>
		<link type="text/rcss" href="theme.rcss" />
		<link type="text/rcss" href="components.rcss" />
		<link type="text/rcss" href="shell.rcss" />
	</head>

	<body data-model="shell">

		<div id="topbar" window-drag="">
			<img id="logo" src="Logo.png" window-drag="" />
			<div id="tabs" window-drag="">
				<div class="tab" data-class-on="tab == 'topics'" data-event-click="set_tab('topics')">
					<icon name="radio" /><span>Topics</span><span class="count mono">{{topic_count}}</span>
				</div>
				<div class="tab" data-class-on="tab == 'nodes'" data-event-click="set_tab('nodes')">
					<icon name="box" /><span>Nodes</span><span class="count mono">{{peer_count}}</span>
				</div>
			</div>
			<div id="theme-toggle" data-event-click="toggle_theme">
				<icon data-attr-name="light ? 'moon' : 'sun'" />
			</div>
			<div id="window-buttons">
				<div class="window-button minimize" data-event-click="minimize_window"><icon name="minus" /></div>
				<div class="window-button maximize" data-event-click="maximize_window">
					<icon data-attr-name="maximized ? 'copy' : 'square'" />
				</div>
				<div class="window-button close" data-event-click="close_window"><icon name="x" /></div>
			</div>
		</div>

		<div id="content">

			<!-- =========================================================== Topics tab -->
			<div id="topics" class="tab-content" data-if="tab == 'topics'">

				<div class="sidebar left">
					<div class="pane-head">
						<div class="filter">
							<icon name="search" />
							<input type="text" class="mono" placeholder="Filter topics..." data-value="topic_filter" />
							<icon name="x" class="clear" data-if="topic_filter != ''" data-event-click="clear_filter" />
						</div>
						<span class="icon-button" data-class-on="topic_cats != 0" data-event-click="open_filter_menu">
							<icon name="funnel" />
						</span>
					</div>
					<div class="tt-head">
						<span class="tt-cell sub"></span>
						<span class="edge"><span class="grip"></span></span>
						<span class="tt-cell share c-topic section" col="topic" keep="">Topic</span>
						<span class="edge c-topic"><span class="grip" data-event-dragstart="drag_column"
								data-event-drag="drag_column"></span></span>
						<span class="tt-cell share c-topic-value section" col="topic-value">Value</span>
						<span class="edge c-topic-value"><span class="grip" data-event-dragstart="drag_column"
								data-event-drag="drag_column"></span></span>
						<span class="tt-cell share c-topic-rate section" col="topic-rate">Rate</span>
						<span class="edge c-topic-rate"><span class="grip" data-event-dragstart="drag_column"
								data-event-drag="drag_column"></span></span>
						<span class="tt-cell share c-topic-jitter section" col="topic-jitter">Jitter</span>
					</div>
					<div id="topic-tree" class="pane-body tt-body" table="topics">
						<div class="placeholder" data-if="tree_total == 0 &amp;&amp; topic_count == 0">no topics
							discovered</div>
						<div class="placeholder"
							data-if="tree_total == 0 &amp;&amp; topic_count > 0 &amp;&amp; filtering">no topics match
						</div>
						<div data-style-height="tree_top"></div>
						<div data-for="r, i : tree_rows">
							<div class="tt-row" row="" data-attr-subtree="r.branch ? r.path : ''"
								data-class-selected="r.path == sel_path" data-class-odd="r.odd"
								data-class-namespace="!r.has_topic" data-event-click="click_row(r.path, r.has_topic)"
								data-event-mousedown="row_menu(r.path)">
								<span class="tt-cell sub">
									<span class="sub-dot" data-if="tree_cells[i].dot" data-class-on="tree_cells[i].sub"
										data-class-active="tree_cells[i].active" data-class-preview="tree_cells[i].preview"
										data-event-click="toggle_sub(r.path)"></span>
								</span>
								<span class="tt-cell share c-topic tt-tree" data-attr-cell="r.topic_name">
									<span class="indent" data-style-width="r.indent"></span>
									<span class="caret" data-event-click="toggle_branch(r.path)">
										<icon data-if="r.branch"
											data-attr-name="r.open ? 'chevron-down' : 'chevron-right'" />
									</span>
									<icon class="kind" data-if="r.has_topic" data-attr-name="r.kind | icon"
										data-class-function="r.kind == 'function'"
										data-class-variable="r.kind == 'variable'" data-class-task="r.kind == 'task'" />
									<span class="name mono">{{r.name}}{{r.branch ? '/' : ''}}</span>
								</span>
								<span class="tt-cell share c-topic-value mono" cell="">{{tree_cells[i].value}}</span>
								<span class="tt-cell share c-topic-rate num mono" cell="">{{tree_cells[i].rate}}</span>
								<span class="tt-cell share c-topic-jitter num mono"
									cell="">{{tree_cells[i].jitter}}</span>
							</div>
						</div>
						<div data-style-height="tree_bottom"></div>
					</div>
					<div class="pane-foot">
						<span class="section" data-if="!filtering">{{topic_count}} topics</span>
						<span class="section" data-if="filtering">{{topic_matched}} / {{topic_count}} topics</span>
					</div>
				</div>

				<div class="edge splitter">
					<div class="grip" data-event-dragstart="drag_sidebar('left')"
						data-event-drag="drag_sidebar('left')"></div>
				</div>

				<div class="detail">
					<div class="pane-body feed">
						<div class="placeholder" data-if="!has_topic">select a topic</div>
						<div class="detail-head" data-if="has_topic">
							<span class="hero mono" copy="">{{topic.name}}</span>
							<span class="tag">{{topic.kind}}</span>
							<span class="tag">{{topic.reliable ? 'reliable' : 'best effort'}}</span>
							<span class="tag" copy="" data-if="topic.type != '' || value_type != ''">{{topic.type
								!= '' ? topic.type : value_type}}</span>
							<span class="tag" data-if="topic.note != ''">{{topic.note}}</span>
						</div>
						<div class="viz-area" data-if="has_topic">
							<div class="hint" data-if="cards.size == 0"><span>Toggle a field in the value tree to see it
									here.</span></div>
							<div class="viz-card" data-for="c : cards" data-attr-topic="c.topic"
								data-attr-path="c.path">
								<span class="viz-name mono"><span class="viz-topic"
										data-if="c.other">{{c.topic}}</span><span>{{c.name}}</span></span>
								<span class="viz-pin" data-class-on="c.pinned"
									data-event-click="pin_card(c.topic, c.path)">
									<icon name="pin" />
								</span>
								<span class="viz-close" data-event-click="close_card(c.topic, c.path)">
									<icon name="x" />
								</span>
								<viz data-attr-topic="c.topic" data-attr-path="c.path"></viz>
							</div>
						</div>
					</div>
				</div>

				<div class="edge splitter">
					<div class="grip" data-event-dragstart="drag_sidebar('right')"
						data-event-drag="drag_sidebar('right')"></div>
				</div>

				<div class="sidebar right" data-attr-topic="topic.name" path="">
					<div class="pane-head">
						<span class="section" data-if="value_type == ''">Value</span>
						<span class="head-type mono" copy="" data-if="value_type != ''">{{value_type}}</span>
						<span class="head-note"
							data-if="value_note != ''">{{value_note}}</span>
						<span class="icon-button" data-if="value_writable" data-class-off="value_edit_count == 0"
							data-event-click="undo_values">
							<icon name="undo-2" />
						</span>
						<span class="icon-button flag" data-if="value_writable" data-class-on="value_repeat"
							data-class-locked="value_repeating" data-event-click="toggle_repeat">
							<icon name="repeat" />
						</span>
						<span class="button primary" data-if="value_writable &amp;&amp; !value_repeating"
							data-class-off="(value_edit_count == 0 &amp;&amp; !value_repeat) || value_bad"
							data-event-click="send">
							<icon name="repeat" data-if="value_repeat" /><span>Set</span>
						</span>
						<span class="button" data-if="value_can_compose &amp;&amp; !value_composing"
							data-event-click="compose(true)">
							<icon name="pencil" /><span>Compose</span>
						</span>
						<span class="icon-button flag" data-if="value_composing" data-class-on="value_repeat"
							data-class-locked="value_repeating" data-event-click="toggle_repeat">
							<icon name="repeat" /><input type="text" class="rate mono" size="3"
								data-value="value_hz" /><span>Hz</span>
						</span>
						<span class="icon-button" data-if="value_composing" data-event-click="compose(false)">
							<icon name="x" />
						</span>
						<span class="button primary" data-if="value_composing &amp;&amp; !value_repeating"
							data-class-off="value_bad" data-event-click="send">
							<icon name="repeat" data-if="value_repeat" /><span>Send</span>
						</span>
						<span class="button" data-if="value_repeating" data-event-click="stop"><span>Stop</span></span>
						<span class="button primary" data-if="value_kind == 'function'"
							data-class-off="value_bad || value_calling" data-event-click="call"><span>Call</span></span>
						<span class="button primary" data-if="value_kind == 'task' &amp;&amp; !value_calling"
							data-class-off="value_bad" data-event-click="call"><span>Run</span></span>
						<span class="button" data-if="value_kind == 'task' &amp;&amp; value_calling"
							data-event-click="cancel"><span>Cancel</span></span>
						<div class="head-bar" data-if="value_progress != ''">
							<div data-style-width="value_progress != '' ? value_progress : '0%'"></div>
						</div>
						<span class="viz-toggle" data-if="value_root_toggle" data-class-on="value_root_on"
							data-event-click="toggle_value('')"></span>
					</div>
					<div class="tt-head">
						<span class="tt-cell share c-field section" col="field" keep="">Field</span>
						<span class="edge c-field"><span class="grip" data-event-dragstart="drag_column"
								data-event-drag="drag_column"></span></span>
						<span class="tt-cell share c-type section" col="type">Type</span>
						<span class="edge c-type"><span class="grip" data-event-dragstart="drag_column"
								data-event-drag="drag_column"></span></span>
						<span class="tt-cell share c-value section" col="value">Value</span>
						<span class="tt-cell toggle"></span>
					</div>
					<div id="value-tree" class="pane-body tt-body">
						<div class="placeholder" data-if="!has_topic">select a topic</div>
						<div class="placeholder" data-if="has_topic &amp;&amp; value_total == 0">{{value_status}}</div>
						<div data-style-height="value_top"></div>
						<div data-for="r, i : value_rows">
							<div class="tt-row value-row" row="" data-class-branch="r.branch" data-class-gap="r.gap"
								data-class-odd="r.odd" data-class-part="r.part" data-class-blank="r.blank"
								data-attr-subtree="r.branch ? r.path : ''"
								data-event-click="fold_value(r.path, r.branch)">
								<span class="tt-cell share c-field tt-tree" cell="" data-class-scrub="r.scrub"
									data-event-dragstart="scrub_value(r.path)" data-event-drag="scrub_value(r.path)">
									<span class="indent" data-style-width="r.indent"></span>
									<span class="caret">
										<icon data-if="r.branch"
											data-attr-name="r.open ? 'chevron-down' : 'chevron-right'" />
									</span>
									<span class="name mono">{{r.name}}</span>
								</span>
								<span class="tt-cell share c-type type" cell="">{{r.type}}</span>
								<span class="tt-cell share c-value val-cell" cell="" data-attr-cell-path="r.path">
									<span class="edit-mark" data-if="r.editor != ''"
										data-class-edited="value_cells[i].edited"
										data-event-click="reset_value(r.path)"><span class="mark-dot"></span>
										<icon name="undo-2" />
									</span>
									<span class="val mono" data-if="r.editor == ''"
										data-class-ok="value_cells[i].tone == 1"
										data-class-bad="value_cells[i].tone == 2"
										data-class-busy="value_cells[i].tone == 3">{{value_cells[i].text}}</span>
									<input type="text" class="pill-edit mono" data-if="r.editor == 'text'"
										data-attr-value="value_cells[i].text" data-attr-size="value_cells[i].size"
										data-class-bad="value_cells[i].bad" data-class-writing="value_cells[i].writing"
										data-event-change="edit_value(r.path)" data-event-keydown="edit_key(r.path)"
										data-event-mousescroll="wheel_value(r.path)" />
									<span class="bool-edit mono" data-if="r.editor == 'bool'"
										data-class-writing="value_cells[i].writing"
										data-event-click="flip_value(r.path)">
										<span>{{value_cells[i].text}}</span><span class="switch"
											data-class-on="value_cells[i].text == 'true'"><span
												class="knob"></span></span>
									</span>
									<select class="pill-edit mono" data-if="r.editor == 'enum'"
										data-style-width="r.width" data-attr-value="value_cells[i].text"
										data-class-writing="value_cells[i].writing"
										data-event-change="edit_value(r.path)">
										<option data-for="o : r.options" data-attr-value="o">{{o}}</option>
									</select>
								</span>
								<span class="tt-cell toggle">
									<span class="viz-toggle" data-if="!r.gap &amp;&amp; !r.part" data-class-on="r.on"
										data-event-click="toggle_value(r.path)"></span>
								</span>
							</div>
						</div>
						<div data-style-height="value_bottom"></div>
					</div>
					<div class="error-text mono" copy="" data-if="value_problem != ''">{{value_problem}}</div>
				</div>

			</div>

			<!-- ============================================================ Nodes tab -->
			<div id="nodes" class="tab-content" data-if="tab == 'nodes'">

				<div class="sidebar left">
					<div class="pane-body" copy-table="">
						<div class="placeholder" data-if="machines.size == 0">no nodes discovered</div>
						<div data-for="m : machines">
							<div class="list-group">{{m.host}}</div>
							<div data-for="n : m.nodes">
								<div class="list-row" row="" data-class-selected="n.id == sel.id"
									data-event-click="select_node(n.id)">
									<span class="dot" data-class-ok="n.alive" data-class-warn="!n.alive"></span>
									<span class="list-label" cell="">{{n.name}}</span>
									<span class="list-trail warn" cell="" data-if="!n.alive">joining</span>
									<span class="list-trail mono" cell=""
										data-if="n.alive &amp;&amp; n.rtt_samples > 0">{{n.rtt_ms | ms}}</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="edge splitter">
					<div class="grip" data-event-dragstart="drag_sidebar('left')"
						data-event-drag="drag_sidebar('left')"></div>
				</div>

				<div class="detail">
					<div class="pane-body">
						<div class="placeholder" data-if="!has_selection">select a node</div>
						<div data-if="has_selection">

							<div class="detail-head">
								<span class="hero" copy="">{{sel.name}}</span>
								<span class="badge ok" data-if="sel.alive">ALIVE</span>
								<span class="badge warn" data-if="!sel.alive">JOINING</span>
							</div>

							<div class="section">Discovery</div>
							<div class="panel" copy-table="">
								<div class="kv-row">
									<div class="kv"><span class="k">Unicast locator</span><span
											class="v mono">{{sel.address}}</span></div>
									<div class="kv"><span class="k">Discovery group</span><span
											class="v mono">{{discovery_group}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Last announce</span><span
											class="v mono">{{sel.last_heard_s | age}}</span></div>
									<div class="kv"><span class="k">Observed for</span><span
											class="v mono">{{sel.observed_s | dur}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Announce updates</span><span
											class="v mono">{{sel.updates}}</span></div>
									<div class="kv"><span class="k">Fragment size</span><span
											class="v mono">{{sel.fragment_size | bytes}}</span></div>
								</div>
							</div>

							<div class="section">Link (measured from here)</div>
							<div class="panel" copy-table="">
								<div class="kv-row">
									<div class="kv"><span class="k">Round trip</span><span class="v mono">{{sel.rtt_ms |
											ms}}</span></div>
									<div class="kv"><span class="k">Jitter</span><span class="v mono">{{sel.jitter_ms |
											ms}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Fastest</span><span class="v mono">{{sel.rtt_min_ms
											| ms}}</span></div>
									<div class="kv"><span class="k">Samples</span><span
											class="v mono">{{sel.rtt_samples}}</span></div>
								</div>
							</div>

							<div class="section">Runtime</div>
							<div class="panel" copy-table="" data-if="!meta.fresh">
								<div class="kv-row">
									<div class="kv"><span class="k">Status</span><span
											class="v mono">{{meta.status}}</span></div>
								</div>
							</div>
							<div class="panel" copy-table="" data-if="meta.fresh">
								<div class="kv-row">
									<div class="kv"><span class="k">Uptime</span><span class="v mono">{{meta.uptime_s |
											dur}}</span></div>
									<div class="kv"><span class="k">Snapshot age</span><span class="v mono">{{meta.age_s
											| age}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Peers</span><span class="v mono">{{meta.peers}} /
											{{meta.max_peers}}</span></div>
									<div class="kv"><span class="k">Topics</span><span class="v mono">{{meta.topics}} /
											{{meta.max_topics}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Mem in use</span><span
											class="v mono">{{meta.mem_in_use | bytes}}</span></div>
									<div class="kv"><span class="k">Mem peak</span><span class="v mono">{{meta.mem_peak
											| bytes}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">Alloc calls</span><span
											class="v mono">{{meta.alloc_calls | num}}</span></div>
									<div class="kv"><span class="k">Evicted unsent</span><span
											class="v mono">{{meta.evicted_unsent | num}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">BP waits</span><span class="v mono">{{meta.bp_waits
											| num}}</span></div>
									<div class="kv"><span class="k">BP waited</span><span
											class="v mono">{{meta.bp_waited_s | dur}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv"><span class="k">SHM sent</span><span class="v mono">{{meta.shm_tx |
											num}}</span></div>
									<div class="kv"><span class="k">SHM received</span><span
											class="v mono">{{meta.shm_rx | num}}</span></div>
								</div>
								<div class="kv-row">
									<div class="kv">
										<span class="k">Last error</span>
										<span class="v mono" data-if="meta.last_error != ''">{{meta.last_error}}</span>
										<span class="v faint" data-if="meta.last_error == ''">none</span>
									</div>
								</div>
							</div>

							<div data-if="meta.fresh">
								<div class="section">Peers</div>
								<div class="panel" copy-table="">
									<div class="kv-row" data-if="meta.peer_rows.size == 0">
										<div class="kv"><span class="k">Peers</span><span class="v faint">none</span>
										</div>
									</div>
									<table data-if="meta.peer_rows.size > 0">
										<tr>
											<th class="wide">Peer</th>
											<th class="num">Round trip</th>
											<th class="num">Jitter</th>
											<th class="num">Fastest</th>
											<th class="num">Samples</th>
											<th class="num">Lanes out</th>
											<th class="num">Lanes in</th>
										</tr>
										<tr data-for="p : meta.peer_rows">
											<td>{{p.name}}<span class="warn" data-if="!p.active"> (dropped)</span></td>
											<td class="num mono">{{p.rtt_ms | ms}}</td>
											<td class="num mono">{{p.jitter_ms | ms}}</td>
											<td class="num mono">{{p.rtt_min_ms | ms}}</td>
											<td class="num mono">{{p.samples}}</td>
											<td class="num mono">{{p.publish_to}}</td>
											<td class="num mono">{{p.receive_from}}</td>
										</tr>
									</table>
								</div>

								<div class="section">Process</div>
								<div class="panel" copy-table="">
									<div class="kv-row" data-if="!meta.have_proc">
										<div class="kv"><span class="k">Process stats</span><span class="v faint">not
												measured on that platform</span></div>
									</div>
									<div class="kv-row" data-if="meta.have_proc">
										<div class="kv"><span class="k">CPU</span><span class="v mono">{{meta.cpu_pct |
												pct}}</span></div>
										<div class="kv"><span class="k">PID</span><span
												class="v mono">{{meta.pid}}</span></div>
									</div>
									<div class="kv-row" data-if="meta.have_proc">
										<div class="kv"><span class="k">Memory (RSS)</span><span
												class="v mono">{{meta.rss | bytes}}</span></div>
										<div class="kv"><span class="k">Peak RSS</span><span
												class="v mono">{{meta.peak_rss | bytes}}</span></div>
									</div>
									<div class="kv-row" data-if="meta.heap_total > 0">
										<div class="kv"><span class="k">Default heap</span><span
												class="v mono">{{meta.heap_total | bytes}}</span></div>
										<div class="kv"><span class="k">Free now</span><span
												class="v mono">{{meta.heap_free | bytes}}</span></div>
									</div>
									<div class="kv-row" data-if="meta.heap_total > 0">
										<div class="kv"><span class="k">Minimum free</span><span
												class="v mono">{{meta.heap_min_free | bytes}}</span></div>
										<div class="kv"><span class="k">Largest block</span><span
												class="v mono">{{meta.heap_largest | bytes}}</span></div>
									</div>
								</div>
							</div>

							<div class="section">Publishes {{publishes.size}}</div>
							<div class="cards" copy-table="">
								<div class="placeholder" data-if="publishes.size == 0">none</div>
								<div class="card" row="" data-for="e : publishes">
									<icon class="kind" data-attr-name="e.kind | icon"
										data-class-function="e.kind == 'function'"
										data-class-variable="e.kind == 'variable'" data-class-task="e.kind == 'task'" />
									<span class="name mono" cell="">{{e.name}}</span>
								</div>
							</div>

							<div class="section">Subscribes {{subscribes.size}}</div>
							<div class="cards" copy-table="">
								<div class="placeholder" data-if="subscribes.size == 0">none</div>
								<div class="card" row="" data-for="e : subscribes">
									<icon class="kind" data-attr-name="e.kind | icon"
										data-class-function="e.kind == 'function'"
										data-class-variable="e.kind == 'variable'" data-class-task="e.kind == 'task'" />
									<span class="name mono" cell="">{{e.name}}</span>
								</div>
							</div>

						</div>
					</div>
				</div>

				<div class="edge splitter">
					<div class="grip" data-event-dragstart="drag_sidebar('right')"
						data-event-drag="drag_sidebar('right')"></div>
				</div>

				<div class="sidebar right">
					<div class="pane-head">
						<span class="section">Node log</span>
						<span class="pill bad" data-class-on="log_error" data-event-click="toggle_log(0)">ERR</span>
						<span class="pill warn" data-class-on="log_warn" data-event-click="toggle_log(1)">WARN</span>
						<span class="pill" data-class-on="log_info" data-event-click="toggle_log(2)">INFO</span>
					</div>
					<div class="pane-body" copy-table="">
						<div class="placeholder" data-if="!has_selection">select a node</div>
						<div class="placeholder" data-if="has_selection &amp;&amp; log.size == 0">no log lines</div>
						<div class="feed-row" row="" data-for="l : log">
							<span class="dot" data-class-bad="l.level == 0" data-class-warn="l.level == 1"></span>
							<div class="feed-body">
								<span class="feed-time mono" cell="">{{l.time}}</span>
								<span class="feed-text mono" cell="">{{l.text}}</span>
							</div>
						</div>
					</div>
				</div>

			</div>

		</div>

		<div id="statusbar">
			<span class="mono" copy="" data-if="status != ''" data-class-bad="status_level == 0"
				data-class-warn="status_level == 1">{{status}}</span>
			<span id="note" data-if="note != ''">{{note}}</span>
		</div>

		<div id="menu-layer" data-if="menu_open" data-event-mousedown="close_menu">
			<div class="menu" data-style-left="menu_left" data-style-top="menu_top">
				<div class="menu-item" data-for="m, i : menu_items" data-class-header="m.header"
					data-event-click="menu_pick(i)">
					<span class="menu-box" data-if="m.check > 0" data-class-on="m.check == 2">
						<icon name="check" />
					</span>
					<span class="menu-label">{{m.label}}</span>
					<span class="menu-hint mono" data-if="m.hint != ''">{{m.hint}}</span>
				</div>
			</div>
		</div>

	</body>
</rml>