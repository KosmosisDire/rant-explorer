/* The application frame and the slots a tab fills. This is the only file that sizes
   anything.

   The whole layout is flex with definite bases, no percentages except where the parent's
   size is already definite. Two documented RCSS rules say why (rcss/flexboxes.md):
     - `flex: 1` is `1 1 0`. `flex: 1 1 auto` is a shrink-to-fit basis, which leaves a pane
       as wide as its own text.
     - stretched items are not reformatted, so a child sized in percent against a merely
       stretched parent measures the pre-stretch box. */

body {
	display: flex;
	flex-direction: column;
}

/* ------------------------------------------------------------------- the frame */

#topbar {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 10dp;
	height: 42dp;
	padding: 0dp 10dp;
	background-color: var(--panel);
	border-bottom: 1dp var(--border);
	filter: drop-shadow(var(--shadow-color) 0dp 0dp 10dp);
	z-index: 1000;
}

#logo {
	width: 26dp;
	height: 26dp;
	filter: drop-shadow(var(--shadow-color) 0dp 0dp 10dp);
}

/* The auto margin pushes everything after the tabs to the right edge. */
#tabs {
	display: flex;
	height: 100%;
	margin-right: auto;
}

/* The active tab is told by colour and an accent underline, never by weight or a fill.
   The underline is always there, transparent while off, so nothing moves. */
.tab {
	display: flex;
	align-items: center;
	gap: 7dp;
	height: 100%;
	padding: 0dp 13dp;
	font-size: 13dp;
	font-weight: 600;
	color: var(--dim);
	border-bottom: 2dp transparent;
	transition: color 0.12s;
}

/* One line between neighbours and none at the ends. */
.tab:not(:last-child) {
	border-right: 1dp var(--border);
}

.tab:hover  { color: var(--text); }
.tab.on     { color: var(--text); border-bottom-color: var(--accent); }
.tab icon   { font-size: 15dp; }
.tab .count { font-size: 10dp; font-weight: normal; color: var(--faint); }

/* The theme and the sidebar toggles. A toggle is lit while its sidebar shows and dims where
   the tab has no such sidebar, so nothing beside it moves. */
.bar-button {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 30dp;
	height: 30dp;
	border-radius: var(--radius);
	font-size: 16dp;
	color: var(--dim);
}

.bar-button:hover { color: var(--text); background-color: var(--panel3); }
.bar-button.on    { color: var(--text); }
.bar-button.off   { opacity: 0.35; pointer-events: none; }

/* The window's own buttons, the topbar being its title bar. They run the full height to
   the right edge, where a flung pointer lands on close. */
#window-buttons {
	display: flex;
	height: 100%;
	margin-right: -10dp;   /* past the bar's padding, so close meets the corner */
	border-left: 1dp var(--border);
}

.window-button {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 46dp;
	height: 100%;
	font-size: 15dp;
	color: var(--dim);
	transition: color background-color 0.1s;
}

.window-button:hover       { color: var(--text); background-color: var(--panel3); }
.window-button.close:hover { color: var(--on-fill); background-color: var(--red); }

.window-button.close icon { font-size: 17dp;}
.window-button.maximize icon { font-size: 13dp;}

#statusbar {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: var(--gap);
	height: 26dp;
	padding: 0dp 14dp;
	font-size: 11dp;
	color: var(--dim);
	background-color: var(--panel);
	border-top: 1dp var(--border);
	z-index: 1000;
}

/* What hot reload or a copy just did, or what RmlUi complained about while parsing. */
#note { color: var(--accent); }

/* ------------------------------------------------------------------- tab slots */

/* The height the two bars leave. A zero basis keeps this off the content, which would
   otherwise grow the column and push the status bar off screen. */
#content {
	flex: 1;
	/* In column mode RmlUi gives a flex item an automatic minimum size equal to its
	   content, so a long enough tab refuses to shrink, overflows the column and shoves the
	   status bar off. This opts out, handing the overflow to the pane that scrolls. */
	min-height: 0;
	display: flex;
	position: relative;
}

/* Under a sidebar that is over the detail, so a tap beside the sidebar closes it. */
#scrim {
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	z-index: 550;
	background-color: rgba(0, 0, 0, 115);
}

/* One tab: a row of sidebars, splitters and the detail pane. A tab may leave any out. */
.tab-content {
	flex: 1;
	height: 100%;
	display: flex;
}

/* A sidebar is a column: an optional head, the body that scrolls, an optional foot. */
.sidebar {
	flex: 0 0 auto;
	height: 100%;
	display: flex;
	flex-direction: column;
	background-color: var(--surface);
	filter: drop-shadow(var(--shadow-color) 0dp 0dp 15dp);
}

/* A sidebar with no head starts its list a little down. */
.sidebar > .pane-body:first-child { padding-top: var(--pad); }

.sidebar.left  { width: var(--sidebar-left); }
.sidebar.right { width: var(--sidebar-right); }

/* A sidebar opens and closes by its width. Its contents keep their full width, held to the
   edge that moves, so they slide rather than reflow. */
.sidebar { overflow: hidden; transition: width 0.2s cubic-out; }
.sidebar.left  { align-items: flex-end; }
.sidebar.left > *  { flex-shrink: 0; width: var(--sidebar-left); }
.sidebar.right > * { flex-shrink: 0; width: var(--sidebar-right); }

/* Where each sidebar sits, from classes main.cpp puts on body: docked unless closed, or over
   the detail pane on a phone. */
body.left-closed .sidebar.left, body.right-closed .sidebar.right { width: 0dp; }
body.left-closed .splitter.left, body.right-closed .splitter.right { display: none; }

body.left-over .tab-content { position: relative; }
body.left-over .splitter.left { display: none; }
body.left-over .sidebar.left {
	position: absolute;
	left: 0dp;
	top: 0dp;
	bottom: 0dp;
	z-index: 600;
}

/* The edge between a sidebar and the detail pane, over both so its grip reaches past it. */
.splitter { z-index: 500; }

/* The pane is only the slot. Its .pane-body child is what scrolls and carries the padding. */
.detail {
	flex: 1;
	height: 100%;
	background-color: var(--ground);
}

/* A head is a panel band, except the detail's own, which stays on the ground. */
.pane-head {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 6dp;
	height: var(--bar);
	padding: 0dp 10dp 0dp var(--pad);
	background-color: var(--panel);
	border-bottom: 1dp var(--border);
}

.detail > .pane-head { background-color: transparent; border-bottom-width: 0dp; }

/* A finger's head pads both ends alike, so a framed button at the end clears the edge. */
body.touch .pane-head { padding: 0dp var(--pad); }

.pane-head .section {
	margin: 0dp;
	margin-right: auto;
}

.pane-head .filter {
	flex: 1;
}

.pane-foot {
	flex: 0 0 auto;
	padding: var(--pad);
	border-top: 1dp var(--border);
}

.pane-foot .section {
	margin: 0dp;
}

/* The scrolling body of a pane. Each one scrolls itself, so nothing else in the tree
   needs an overflow rule. */
.pane-body {
	width: 100%;
	overflow-y: auto;
}

.sidebar > .pane-body {
	flex: 1;
	min-height: 0;
}

/* The columns of the topic tree and the value tree, shared by each header and its rows.
   Each takes its weight's share of the width, and a class on body hides any of them. */
.tt-cell.c-topic        { flex-grow: var(--c-topic); }
.tt-cell.c-topic-value  { flex-grow: var(--c-topic-value); }
.tt-cell.c-topic-rate   { flex-grow: var(--c-topic-rate); }
.tt-cell.c-topic-jitter { flex-grow: var(--c-topic-jitter); }
.tt-cell.c-field        { flex-grow: var(--c-field); }
.tt-cell.c-type         { flex-grow: var(--c-type); }
.tt-cell.c-value        { flex-grow: var(--c-value); }

body.hide-topic-value .c-topic-value,
body.hide-topic-rate .c-topic-rate,
body.hide-topic-jitter .c-topic-jitter,
body.hide-type .c-type,
body.hide-value .c-value { display: none; }

.detail > .pane-body {
	height: 100%;
	padding: 18dp 18dp 28dp 18dp;
}

/* The topic feed: the head, then the cards taking the rest of the pane. */
.detail > .pane-body.feed {
	display: flex;
	flex-direction: column;
}

.feed .detail-head, .feed .issues { flex: 0 0 auto; }

/* With nothing picked the detail says so in its middle, clear of the floating drawer button. */
.detail > .pane-body > .placeholder {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 100%;
}

/* The cards are tiled by tile_cards in main.cpp, which writes each one's box inline, so
   the area only has to be the rest of the pane. The visual takes the card's height from a
   zero basis, so its own size never feeds back. */
.viz-area {
	position: relative;
	flex: 1 1 0;
	min-height: 0;
}

.viz-card { position: absolute; }

.viz-card viz { flex: 1 1 0; min-height: 0; }

/* The mesh tab's detail is its head over the graph, which takes the rest. */
.detail.graph {
	display: flex;
	flex-direction: column;
}

.detail.graph mesh-graph {
	flex: 1 1 0;
	min-height: 0;
}

.mesh-info { padding: var(--pad); }

/* --------------------------------------------------------------------- compact */

/* A phone shows the detail whole. The top bar folds away: its left toggle floats as the
   drawer button and its tabs head the drawer. The left sidebar is that drawer, the right
   one a sheet along the bottom. */
.sheet-grip { display: none; }

body.compact #topbar {
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	height: 0dp;
	padding: 0dp;
	border-width: 0dp;
	filter: none;
}

body.compact #logo, body.compact #topbar .bar-button, body.compact #window-buttons,
body.compact #statusbar, body.compact .splitter { display: none; }

body.compact .tab-content { position: relative; }
body.compact .viz-area { margin: 68dp 0dp 12dp 0dp; overflow: hidden; }   /* clear of the floating head and the grip alike */

body.compact #topbar .bar-button.left-toggle {
	display: flex;
	position: absolute;
	left: 12dp;
	top: 12dp;
	width: 44dp;
	height: 44dp;
	background-color: var(--float);
	border: 1dp var(--border2);
	border-radius: 10dp;
	color: var(--text);
}

body.compact.left-over #topbar .bar-button.left-toggle { display: none; }

/* The drawer and its tabs slide together, so both sit at the same width. */
body.compact #tabs, body.compact .sidebar.left {
	width: 86%;
	max-width: 340dp;
	transform: translateX(-100%);
	transition: transform 0.22s cubic-out;
}

body.compact.left-over #tabs, body.compact.left-over .sidebar.left { transform: translateX(0%); }

body.compact #tabs {
	position: absolute;
	left: 0dp;
	top: 0dp;
	height: var(--bar);
	margin: 0dp;
	background-color: var(--panel);
	border-bottom: 1dp var(--border);
}

body.compact .tab { flex: 1; justify-content: center; }

body.compact .sidebar.left, body.compact.left-closed .sidebar.left {
	position: absolute;
	left: 0dp;
	top: 0dp;
	bottom: 0dp;
	height: auto;
	padding-top: var(--bar);
	z-index: 600;
}

body.compact .sidebar.left > * { width: 100%; }

/* The drawer floats, so its inner corners round, the tabs on its top edge with it. */
body.compact .sidebar.left { border-radius: 0dp 16dp 16dp 0dp; }
body.compact #tabs { border-radius: 0dp 16dp 0dp 0dp; }

/* The sheet: the right sidebar along the bottom, at the height main.cpp sets. No border,
   since RmlUi dots the corner where a one sided border meets a radius. */
body.compact .sidebar.right, body.compact.right-closed .sidebar.right {
	position: absolute;
	left: 0dp;
	right: 0dp;
	bottom: 0dp;
	width: auto;
	height: var(--sheet);
	border-radius: 16dp 16dp 0dp 0dp;
	transition: height 0.22s cubic-out;
	z-index: 500;
}

body.compact.right-closed .sidebar.right { height: 0dp; }
body.compact .sidebar.right > * { width: 100%; }
body.compact .sidebar.right > .tt-head { display: none; }
body.compact .c-topic-value, body.compact .c-topic-jitter, body.compact .c-type { display: none; }

/* An iconic button drops its label and frame, a plain glyph like an icon button. */
body.compact .button.iconic { min-width: var(--hit); padding: 0dp 7dp; color: var(--dim); background-color: transparent; border-width: 0dp; }
body.compact .button.iconic span { display: none; }
body.compact .button.iconic icon { margin-right: 0dp; }

/* The grip heads the sheet, wide enough to tap, and is all a closed sheet shows. The
   sheet's head drags it too. */
body.compact .sidebar.right > .sheet-grip {
	display: block;
	height: var(--grip);
	border-radius: 16dp 16dp 0dp 0dp;
	background-color: var(--panel);
	drag: drag;
}

body.compact .sheet-grip > div {
	width: 40dp;
	height: 5dp;
	margin: 11dp auto 0dp auto;
	border-radius: 3dp;
	background-color: var(--border2);
}

body.compact .sidebar.right > .pane-head { drag: drag; }
body.compact.sheet-dragging .sidebar.right { transition: none; }

/* The detail fills the screen under the drawer button and ends above a closed sheet. The
   topic's head floats beside the button. */
body.compact .detail { padding-bottom: var(--grip); }
body.compact .detail > .pane-body { padding: 68dp 16dp 16dp 16dp; }
body.compact .detail > .pane-body.feed { padding: 0dp; }
body.compact .detail.graph > .pane-head { padding-left: 68dp; height: 68dp; }

body.compact .feed .detail-head {
	position: absolute;
	left: 68dp;
	right: 12dp;
	top: 12dp;
	height: 44dp;
	padding: 0dp 14dp;
	z-index: 10;
	overflow: hidden;
	background-color: var(--float);
	border: 1dp var(--border2);
	border-radius: 10dp;
}

body.compact .feed .detail-head .hero { flex: 1 1 0; overflow: hidden; white-space: nowrap; font-size: 15dp; }
body.compact .feed .detail-head .tag { display: none; }

/* A phone shows one card at a time. A sideways drag of a card or of the head pages them, and
   a visual that drags itself pages by the head. The dots say where, and a tap on one goes. */
body.compact .viz-card, body.compact .feed .detail-head { drag: drag; }

.pager { display: none; }
body.compact .pager { display: flex; height: 100%; }
.pager-dot {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 14dp;
	height: 100%;
}
.pager-dot > span { width: 6dp; height: 6dp; border-radius: 3dp; background-color: var(--border2); }
.pager-dot.on { width: 26dp; }
.pager-dot.on > span { width: 18dp; background-color: var(--accent); }

/* ------------------------------------------------------------------------ menu */

/* The open menu sits on a layer over the whole window, which a press outside it closes.
   main.cpp places the menu at the pointer and keeps it in the window by these sizes. */
#menu-layer {
	position: absolute;
	left: 0dp;
	top: 0dp;
	right: 0dp;
	bottom: 0dp;
	z-index: 2000;
}

#menu-layer .menu {
	position: absolute;
	width: 200dp;
}

/* A sidebar's error line sits between its head and its body and takes what its text needs. */
.sidebar > .error-text { flex: 0 0 auto; }
