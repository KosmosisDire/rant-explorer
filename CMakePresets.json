{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio)",
      "description": "Newest installed Visual Studio, Rant from the pinned release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux (Ninja)",
      "description": "Ninja, Rant from the pinned release",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos",
      "displayName": "macOS (Ninja)",
      "description": "Ninja, Rant from the pinned release",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows-local",
      "inherits": "windows",
      "displayName": "Windows (Visual Studio), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": { "CPM_rant_SOURCE": "${sourceDir}/../rant" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-local",
      "inherits": "linux",
      "displayName": "Linux (Ninja), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": { "CPM_rant_SOURCE": "${sourceDir}/../rant" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "macos-local",
      "inherits": "macos",
      "displayName": "macOS (Ninja), local Rant",
      "description": "Rant from the ../rant working tree",
      "cacheVariables": { "CPM_rant_SOURCE": "${sourceDir}/../rant" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "description": "Ninja and the emsdk in EMSDK, Rant and rant-client from the pinned releases",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "web-local",
      "inherits": "web",
      "displayName": "Web (Emscripten), local Rant and client",
      "description": "Rant from ../rant, rant-client from ../bridge-rant/client/dist",
      "cacheVariables": {
        "CPM_rant_SOURCE": "${sourceDir}/../rant",
        "RANT_CLIENT_DIR": "${sourceDir}/../bridge-rant/client/dist"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "linux", "configurePreset": "linux", "configuration": "Release" },
    { "name": "macos", "configurePreset": "macos", "configuration": "Release" },
    { "name": "windows-local", "configurePreset": "windows-local", "configuration": "Release" },
    { "name": "linux-local", "configurePreset": "linux-local", "configuration": "Release" },
    { "name": "macos-local", "configurePreset": "macos-local", "configuration": "Release" },
    { "name": "web", "configurePreset": "web" },
    { "name": "web-local", "configurePreset": "web-local" }
  ]
}
